---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const docs = (await getCollection('docs')).sort(
	(a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id)
);
const skills = (await getCollection('skills')).sort((a, b) =>
	a.id.localeCompare(b.id)
);
---

<Layout title="Documentation">
	<h1>Voxie UI Documentation</h1>

	<h2>Docs</h2>
	<ul class="not-prose space-y-3">
		{
			docs.map((entry) => (
				<li class="leading-snug">
					<a href={`/docs/${entry.id}`} class="text-sky-700 hover:text-black font-semibold">
						{entry.data.title}
					</a>
					<br/>
					<span class="text-sm">{entry.data.description}</span>
				</li>
			))
		}
	</ul>

	<h2>Skills</h2>
	<ul class="not-prose space-y-3">
		{
			skills.map((entry) => (
				<li class="leading-snug">
					<a href={`/skills/${entry.id}`} class="text-sky-700 hover:text-black font-semibold">
						{entry.data.title}
					</a>
					<br/>
					<span class="text-sm">{entry.data.description}</span>
				</li>
			))
		}
	</ul>
</Layout>

---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Card from '@ui/Card.vue';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const skills = (await getCollection('skills')).sort((a, b) => a.id.localeCompare(b.id));
---

<Layout title="Documentation">
  <h1>Voxie UI Documentation</h1>

  <Card surface='layered' padding='spacious'>

  <p class="my-0!">Voxie UI is a system built on top of Tailwind, a utility based UI framework for designing interfaces. These docs provide examples, reasoning, and usage guidance for everything that makes up the Voxie design system. It then builds on these with skills to help agents stay aligned with the system.</p>

  </Card>

  <h2>What's here</h2>

  <h3 class="mt-0 mb-0">Docs</h3>
  <p class="">Foundations, components, patterns and guidance.</p>

  <h3 class="mt-0 mb-0">Skills</h3>
  <p class="">The same docs written as instructions for AI agents.</p>

  <h3 class="mt-0 mb-0">Test&nbsp;pages</h3>
  <p class="">A set of real Voxie screens, stripped of every class, for testing guidance and rules.</p>
</Layout>

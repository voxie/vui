---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Card from '@ui/Card.vue';
import Button from '@ui/Button.vue';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
---

<Layout title="Documentation">
  <h1 class="text-3xl">Voxie User Interface Docs</h1>

  <Card
    surface="layered"
    padding="spacious"
  >
    <p class="my-0!">Voxie UI is a system built on top of Tailwind, a utility based UI framework for designing interfaces. These docs provide examples, reasoning, and usage guidance for everything that makes up the Voxie design system. It then builds on these with skills to help agents stay aligned with the system.</p>
  </Card>

  <h2 class="mb-3">What's here</h2>

  <div class="grid lg:grid-cols-3 gap-4 not-prose">
    <Card
      class="flex flex-col"
      padding="compact"
    >
      <h3 class="mb-1">Docs</h3>
      <p class="text-xs text-slate-500 leading-snug grow mb-4">Foundations, components, patterns and guidance.</p>
      <Button href="/docs/foundations/look-and-feel">Look and Feel <i class="fa-solid fa-arrow-right"></i></Button>
    </Card>

    <Card
      class="flex flex-col"
      padding="compact"
    >
      <h3 class="mb-1">Skills</h3>
      <p class="text-xs text-slate-500 leading-snug grow mb-4">The same docs written as instructions for AI agents.</p>
      <Button href="/skills/intro">Skills Intro <i class="fa-solid fa-arrow-right"></i></Button>
    </Card>

    <Card
      class="flex flex-col"
      padding="compact"
    >
      <h3 class="mb-1">Test&nbsp;Pages</h3>
      <p class="text-xs text-slate-500 leading-snug grow mb-4">A set of real Voxie screens, stripped of every class, for testing guidance and rules.</p>
      <Button href="/test-pages">Overview <i class="fa-solid fa-arrow-right"></i></Button>
    </Card>
  </div>
</Layout>

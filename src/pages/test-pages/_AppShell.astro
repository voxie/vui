---
// The application chrome: the navigation bar and the page container. Shared so
// it gets styled once, as the real app is. The bar lives in `_AppNavbar.vue`,
// and each page body is a Vue file too, so the design-system components can
// compose in one tree when they're swapped in. Astro renders a nested Vue
// component as a separate app, which is what a Navbar or a Card can't survive.
import TestPageLayout from '@layouts/TestPageLayout.astro';
import AppNavbar from './_AppNavbar.vue';

interface Props {
	title: string;
	source?: string;
	/* Message Hub and similar own the full viewport and manage their own scroll. */
	fullBleed?: boolean;
}

const { title, source, fullBleed = false } = Astro.props;
---

<TestPageLayout title={title} source={source}>
	<AppNavbar client:load />

	{
		fullBleed ? (
			<slot />
		) : (
			<main data-test="page-container">
				<slot />
			</main>
		)
	}
</TestPageLayout>

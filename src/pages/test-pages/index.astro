---
// The documentation layout and not TestPageLayout: this page is about the
// fixtures, not one of them, so it keeps the sidebar.
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { testPages } from '@data/testPages';
import Card from '@ui/Card.vue';
import Button from '@ui/Button.vue';
import Select from '@ui/Select.vue';

// The brief's reading list is the whole docs collection, grouped and ordered
// the way the sidebar groups it, so a new page joins the brief on its own.
const sectionOrder = ['foundations', 'components', 'patterns'];
const rank = (section: string) => {
  const i = sectionOrder.indexOf(section);
  return i === -1 ? sectionOrder.length : i;
};

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));

const reading = [...new Set(docs.map((entry) => entry.id.split('/')[0]))]
  .sort((a, b) => rank(a) - rank(b) || a.localeCompare(b))
  .map((section) => ({
    dir: `src/content/docs/${section}/`,
    files: docs
      .filter((entry) => entry.id.split('/')[0] === section)
      .map((entry) => `${entry.id.split('/').slice(1).join('/')}.mdx`)
      .join(', '),
  }));

// The brief is data so the card and the clipboard copy can't drift: the card
// renders these lines, and `promptTemplate` is the same ones as plain text.
// The page the brief points at is a token, swapped for the footer's pick on
// both sides.
const PAGE = '{{page}}';
const promptOpening = (page: string) =>
  `Style ${page}. It's real production markup with every class stripped.`;
const pageOptions = testPages.map((page) => ({
  value: `src/pages${page.href}.astro`,
  label: page.title,
}));
const promptReading = 'Read all of these first and treat them as binding:';
const promptRules = [
  'Add classes freely. You may add wrapper elements and swap in the documented components wherever the markup maps to one: Card for a plain container, Button for a button, Input for a text input or textarea and its label, Select for a select, Checkbox and Radio for their inputs, Badge for a data-test="badge" span, Modal for the inline dialog, CharCounter for a length-limited field.',
  "Prefer a component over restyling the raw element. If a component doesn't fit, say why in the gap list rather than working around it silently.",
  "Don't create new components.",
  "Don't remove or rename semantic elements, data-test attributes, or copy, and don't change the data.",
  "Don't touch _AppShell.astro. If you need something like a page background color, put it on the main content wrapper.",
  "When the docs don't answer something, make the call, but keep a running list of every gap you hit.",
];
const promptClosing = 'Then self-review against the checklist in src/pages/test-pages/index.astro and report the gap list.';

const promptTemplate = [
  promptOpening(PAGE),
  [promptReading, ...reading.map((group) => `- ${group.dir} ${group.files}`)].join('\n'),
  ['Rules:', ...promptRules.map((rule) => `- ${rule}`)].join('\n'),
  promptClosing,
].join('\n\n');

const checks = ['Does it use real Tailwind color names, or did it reach for <code>bg-primary</code>?', 'Do neutrals sit one rung from their background, and does each button carry the right <code>surface</code> for the card it is in?', 'Do all five accents stay at 300?', 'Is the default body size <code>text-sm</code>?', 'Does every input, select, checkbox, radio, badge and dialog in the markup reach for the documented component, rather than hand-styled markup that resembles it?', 'Does the dense inbox get a dense treatment, and the wizard a roomy one?', 'Do the empty, loading, and error states get the same care as the happy path?'];
---

<Layout title="Test Pages">
  <h1>Test Pages</h1>

  <p>
    Nine pages of real production markup pulled from the <code>voxie</code> app, stripped of every Tailwind class and filled with static test data. They render as raw semantic HTML. Nothing here is styled — that is the point.
  </p>

  <p>They were picked by layout archetype rather than by feature, so the set spans what the product actually has to lay out: a dense two-pane inbox, a wizard at the opposite density, tables that reflow to cards, a settings column, and a page collecting the states everything else falls into.</p>

  <h2>The pages</h2>

  <ul class="not-prose space-y-3">
    {
      testPages.map((page) => (
        <li class="leading-snug">
          <a
            href={page.href}
            class="text-sky-700 font-semibold hover:text-black"
          >
            {page.title}
          </a>
          <br />
          <span class="text-sm">{page.exercises}</span>
          <br />
          <code class="text-xs bg-slate-300/50 px-1 py-0.5 rounded-sm">{page.source}</code>
        </li>
      ))
    }
  </ul>

  <h2>Running a trial</h2>

  <p>Point an agent at one page with a brief along these lines:</p>

  {/* Padding moves onto the body so the footer can reach the card's edges, the
      way the one in a Modal does. The brief is white on the card's glass, so it
      reads as the thing being handed over. */}
  <Card surface="glass" padding="none">
    <div class="rounded-t-2xl bg-white p-8">
      <p class="mt-0" data-prompt-opening>{promptOpening(pageOptions[0].value)}</p>

      <p>{promptReading}</p>

      <ul>
        {reading.map((group) => <li><code>{group.dir}</code> {group.files}</li>)}
      </ul>

      <h3>Rules:</h3>
      <ul>
        {promptRules.map((rule) => <li>{rule}</li>)}
      </ul>

      <p class="mb-0">{promptClosing}</p>
    </div>

    {/* The Modal footer, borrowed: same border, stacked rather than turning into
        a row, since the pick reads as a step before the copy. Padding matches
        the brief above it so the two share one edge. */}
    <div class="not-prose flex flex-col gap-3 border-t border-solid border-slate-100 p-8">
      <Select
        block
        sits-on="glass"
        label="Page to style"
        options={pageOptions}
        data-prompt-page
      />

      <Button color="sky" block data-copy-prompt>
        <i data-copy-icon class="fa-regular fa-clipboard"></i>
        <span data-copy-label>Copy prompt</span>
      </Button>
    </div>
  </Card>

  {/* Neither control is hydrated, so the picking and the copying are wired up
      here rather than in a Vue island. */}
  <script define:vars={{ promptTemplate, openingTemplate: promptOpening(PAGE), PAGE }}>
    const button = document.querySelector('[data-copy-prompt]');
    const icon = button?.querySelector('[data-copy-icon]');
    const label = button?.querySelector('[data-copy-label]');
    const select = document.querySelector('[data-prompt-page]');
    const opening = document.querySelector('[data-prompt-opening]');
    let reset;

    // Held long enough to read, then the button goes back to its resting label.
    function say(iconClass, text) {
      icon.className = iconClass;
      label.textContent = text;
      clearTimeout(reset);
      reset = setTimeout(() => {
        icon.className = 'fa-regular fa-clipboard';
        label.textContent = 'Copy prompt';
      }, 2000);
    }

    select?.addEventListener('change', () => {
      opening.textContent = openingTemplate.replace(PAGE, select.value);
    });

    button?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(promptTemplate.replace(PAGE, select.value));
        say('fa-solid fa-check', 'Copied');
      } catch {
        say('fa-solid fa-triangle-exclamation', 'Copy failed');
      }
    });
  </script>

  <h2>Review Checklist</h2>

  <ul>
    {checks.map((check) => <li set:html={check} />)}
  </ul>

  <h2>Resetting</h2>

  <p>
    These are fixtures, so they have to survive being styled. Note the commit before handing a page over; <code>git checkout -- src/pages/test-pages/</code> puts every page back to raw markup.
  </p>

  <p>
    Notes on how the markup was stripped from the source components live in <code>src/pages/test-pages/_README.md</code>.
  </p>
</Layout>

---
import { getCollection } from 'astro:content';
import VoxieMark from '@site/VoxieMark.vue';
import Select from '@ui/Select.vue';
import { withBase } from '@lib/base';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const skills = (await getCollection('skills')).sort((a, b) => a.id.localeCompare(b.id));

// Directory names don't sort into a reading order, and the sections build on
// each other: components use foundations, patterns use components. Unlisted
// sections fall last.
const sectionOrder = ['foundations', 'components', 'patterns'];
const rank = (section: string) => {
  const i = sectionOrder.indexOf(section);
  return i === -1 ? sectionOrder.length : i;
};

const sections = [...new Set(docs.map((entry) => entry.id.split('/')[0]))].sort(
  (a, b) => rank(a) - rank(b) || a.localeCompare(b),
);

// Built once and rendered twice, as the wide column and as the narrow select.
// Labels are capitalized here and not with `capitalize`, since `optgroup` labels
// are attribute text CSS can't reach. The intro lives outside, behind the mark.
const groups = [
  ...sections.map((section) => ({
    label: section.charAt(0).toUpperCase() + section.slice(1),
    links: docs
      .filter((entry) => entry.id.split('/')[0] === section)
      .map((entry) => ({ href: withBase(`/docs/${entry.id}`), title: entry.data.title })),
  })),
  {
    label: 'Skills',
    links: [
      { href: withBase('/skills'), title: 'Intro' },
      ...skills.map((entry) => ({ href: withBase(`/skills/${entry.id}`), title: entry.data.name })),
    ],
  },
  // The overview and nothing under it: the fixtures are pages to open, not
  // documentation to browse.
  { label: 'Test Pages', links: [{ href: withBase('/test-pages'), title: 'Overview' }] },
];

// Normalized to one trailing slash so it compares equal to the hrefs above,
// which `withBase` builds slashed.
const currentPath = Astro.url.pathname.replace(/\/*$/, '/');
const home = withBase('/');

function linkClass(href: string) {
  let defaults = 'block px-2 py-0.5 border-l border-l-slate-400/50';
  if (href === currentPath) {
    return defaults + ' ' + 'relative text-sky-700 cursor-default before:absolute before:inset-y-0 before:left-0 before:bg-sky-500 before:w-1 before:rounded-r';
  }
  return defaults + ' ' + 'hover:text-sky-700 group';
}
---

{/* Below `md` the two columns can't both fit, so the nav collapses to a select
    above the content. The content scrolls beneath it, so it needs no sticky. */}
<div class="md:hidden shrink-0 flex items-center gap-3 p-5 bg-slate-200 border-b border-slate-300">
  <a href={home} aria-label="Voxie UI home" class="shrink-0 h-full"><VoxieMark class="h-full! w-auto" /></a>
  {/* Rendered static: the change handler below is all the behavior it needs.
      Wrapped, since a class on Select lands on the select itself. */}
  <div class="flex-1 min-w-0">
  <Select data-docs-nav block sits-on="background" aria-label="Browse documentation">
    {/* Home matches no option; without this the first doc would read as selected. */}
    {currentPath === home && <option value="" hidden selected>Browse…</option>}
    {
      groups.map((group) => (
        <optgroup label={group.label}>
          {group.links.map((link) => (
            <option value={link.href} selected={link.href === currentPath}>
              {link.title}
            </option>
          ))}
        </optgroup>
      ))
    }
  </Select>
  </div>
  <button
    type="button"
    data-search-open
    aria-label="Search"
    class="shrink-0 flex size-10 items-center justify-center rounded-xl bg-white text-slate-500 shadow hover:shadow-md hover:text-slate-800 transition outline-blue-600 focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    <i class="fa-solid fa-magnifying-glass"></i>
  </button>
</div>

<aside
  class="hidden md:block w-56 shrink-0 h-dvh overflow-y-auto overscroll-y-contain p-8 bg-slate-300/30 border-r border-r-white/50 shadow-inner"
>
  <a href={home} class="inline-flex items-center gap-1.5 text-sm font-extrabold hover:opacity-50 transition tracking-widest">
    <VoxieMark class="w-6" />
    VUI
  </a>

  <button
    type="button"
    data-search-open
    class="mt-6 flex h-10 w-full items-center gap-2 rounded-xl bg-white px-4 text-sm text-slate-400 shadow hover:shadow-md hover:text-slate-800 transition outline-blue-600 focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    <i class="fa-solid fa-magnifying-glass text-xs"></i>
    <span class="flex-1 text-left">Search…</span>
    <kbd class="font-sans text-xs font-semibold text-slate-400">⌘K</kbd>
  </button>

  <nav class="text-sm space-y-4 py-7">
    {
      groups.map((group) => (
        <div>
          <h3 class="font-extrabold">{group.label}</h3>
          <ul class="mt-3">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class={linkClass(link.href)}>
                  <span class="group-hover:bg-slate-300/40 rounded-lg px-2 py-1 transition duration-100 text-nowrap">
                    {link.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>

<script>
  // Selecting is the whole interaction — no separate Go button to press.
  const select = document.querySelector<HTMLSelectElement>('[data-docs-nav]');
  select?.addEventListener('change', () => {
    if (select.value) window.location.href = select.value;
  });
</script>

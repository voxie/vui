---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.vue';
import Button from '../ui/Button.vue';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const skills = (await getCollection('skills')).sort((a, b) => a.id.localeCompare(b.id));

const sections = [...new Set(docs.map((entry) => entry.id.split('/')[0]))];
const currentPath = Astro.url.pathname.replace(/\/$/, '');

// The back link has nowhere to go from the home page, but it still holds its
// space so the nav below starts at the same height on every page.
const isHome = currentPath === '';

function linkClass(href: string) {
  let defaults = 'block px-3 py-0.5 border-l border-l-slate-400/50';
  if (href === currentPath) {
    return defaults + ' ' + 'relative text-sky-700 cursor-default before:absolute before:inset-y-0 before:left-0 before:bg-sky-500 before:w-1 before:rounded-r';
  }
  return defaults + ' ' + 'hover:text-sky-700';
}
---

<aside class="w-56 shrink-0 justify-self-end sticky top-8 spa">
  <nav class="text-sm space-y-4">
   

    {
      sections.map((section) => (
        <div>
          <h3 class="font-extrabold capitalize">{section}</h3>
          <ul class="mt-2">
            {docs
              .filter((entry) => entry.id.split('/')[0] === section)
              .map((entry) => (
                <li>
                  <a
                    href={`/docs/${entry.id}`}
                    class={linkClass(`/docs/${entry.id}`)}
                  >
                    {entry.data.title}
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }

    <div>
      <h3 class="font-extrabold capitalize">Skills</h3>
      <ul class="mt-2">
        {
          skills.map((entry) => (
            <li>
              <a
                href={`/skills/${entry.id}`}
                class={linkClass(`/skills/${entry.id}`)}
              >
                {entry.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class:list={[isHome && 'hidden','mt-6']}>
      <Button
        href="/"
        surface="background"
        size="sm"
      >
        <i class="fa-solid fa-arrow-left"></i> Back Home
      </Button>
    </div>
  </nav>
</aside>

---
import { getCollection } from 'astro:content';
import { testPages } from '../../data/testPages';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const skills = (await getCollection('skills')).sort((a, b) => a.id.localeCompare(b.id));

const sections = [...new Set(docs.map((entry) => entry.id.split('/')[0]))];
const currentPath = Astro.url.pathname.replace(/\/$/, '');

function linkClass(href: string) {
  let defaults = 'block px-2 py-0.5 border-l border-l-slate-400/50';
  if (href === currentPath) {
    return defaults + ' ' + 'relative text-sky-700 cursor-default before:absolute before:inset-y-0 before:left-0 before:bg-sky-500 before:w-1 before:rounded-r';
  }
  return defaults + ' ' + 'hover:text-sky-700 group';
}
---

<aside
  class="w-56 shrink-0 justify-self-end sticky top-0 max-h-dvh overflow-y-auto overscroll-y-contain py-8 px-4"
>
  <nav class="text-sm space-y-4">
    {/* '' rather than '/' — currentPath has the trailing slash stripped. */}
    <div>
      <h3 class="font-extrabold capitalize">Voxie UI</h3>
      <ul class="mt-2">
        <li>
          <a href="/" class={linkClass('')}>
            <span class="group-hover:bg-slate-300/40 rounded-lg px-2 py-1 transition duration-100">
            Intro
            </span>
          </a>
        </li>
      </ul>
    </div>

    {
      sections.map((section) => (
        <div>
          <h3 class="font-extrabold capitalize">{section}</h3>
          <ul class="mt-2">
            {docs
              .filter((entry) => entry.id.split('/')[0] === section)
              .map((entry) => (
                <li>
                  <a
                    href={`/docs/${entry.id}`}
                    class={linkClass(`/docs/${entry.id}`)}
                  >
                    <span class="group-hover:bg-slate-300/40 rounded-lg px-2 py-1 transition duration-100">
                    {entry.data.title}
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }

    <div>
      <h3 class="font-extrabold capitalize">Skills</h3>
      <ul class="mt-2">
        {
          skills.map((entry) => (
            <li>
              <a
                href={`/skills/${entry.id}`}
                class={linkClass(`/skills/${entry.id}`)}
              >
                <span class="group-hover:bg-slate-300/40 rounded-lg px-2 py-1 transition duration-100">
                {entry.data.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Unstyled fixtures rather than documentation, so they sit last. */}
    <div>
      <h3 class="font-extrabold capitalize">Test Pages</h3>
      <ul class="mt-2">
        <li>
          <a href="/test-pages" class={linkClass('/test-pages')}>
            <span class="group-hover:bg-slate-300/40 rounded-lg px-2 py-1 transition duration-100">
            Overview
            </span>
          </a>
        </li>
        {
          testPages.map((page) => (
            <li>
              <a href={page.href} class={linkClass(page.href)}>
                <span class="group-hover:bg-slate-300/40 rounded-lg px-2 py-1 transition duration-100">
                {page.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</aside>

---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.vue';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const skills = (await getCollection('skills')).sort((a, b) => a.id.localeCompare(b.id));

const sections = [...new Set(docs.map((entry) => entry.id.split('/')[0]))];
const currentPath = Astro.url.pathname.replace(/\/$/, '');

function linkClass(href: string) {
  let defaults = 'block px-3 py-1 border-l border-l-slate-400/50';
  if (href === currentPath) {
    return defaults + ' ' + 'text-sky-600 cursor-default';
  }
  return defaults + ' ' + 'text-slate-700 hover:text-sky-600';
}
---

<aside class="w-64 shrink-0 px-4 py-12">
  <Card
    surface="sunken"
  >
    <a
      href="/"
      class="block text-sm font-semibold text-slate-900 hover:text-sky-600"
    >
      Documentation
    </a>

    <nav class="mt-6 space-y-6 text-sm">
      {
        sections.map((section) => (
          <div>
            <h3 class="text-xs font-extrabold capitalize">{section}</h3>
            <ul class="mt-2">
              {docs
                .filter((entry) => entry.id.split('/')[0] === section)
                .map((entry) => (
                  <li>
                    <a
                      href={`/docs/${entry.id}`}
                      class={linkClass(`/docs/${entry.id}`)}
                    >
                      {entry.data.title}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }

      <div>
        <h3 class="text-xs font-extrabold capitalize">Skills</h3>
        <ul class="mt-2">
          {
            skills.map((entry) => (
              <li>
                <a
                  href={`/skills/${entry.id}`}
                  class={linkClass(`/skills/${entry.id}`)}
                >
                  {entry.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </Card>
</aside>

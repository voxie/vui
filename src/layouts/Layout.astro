---
// Preloaded below. Font Awesome ships `font-display: block`, so icons stay
// invisible until the file lands; the preload starts that fetch with the HTML
// rather than after the stylesheet parses.
import solidFont from '../styles/fontawesome/webfonts/fa-solid-900.woff2?url';
import '@fontsource-variable/inter/wght.css';
// Font Awesome, self-hosted: the hosted kit was a blocking third-party script
// that cached for 60 seconds, so every navigation waited on a round trip before
// it painted. Only the two families the pages use, classic solid and regular.
import '../styles/fontawesome/css/fontawesome.min.css';
import '../styles/fontawesome/css/solid.min.css';
import '../styles/fontawesome/css/regular.min.css';
import '../styles/global.css';

import Sidebar from '@site/Sidebar.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>VUI - {title}</title>
		<link rel="preload" href={solidFont} as="font" type="font/woff2" crossorigin />
	</head>
	<body class="bg-slate-200">
		{/* The document doesn't scroll; the main column does. Elastic overscroll
		    then bounces the content only, and the nav stays put at every size. */}
		<div class="flex flex-col md:flex-row h-dvh">
			<Sidebar />
			<div class="flex-1 min-w-0 min-h-0 overflow-y-auto overscroll-y-contain">
				<main
					class="prose prose-slate leading-relaxed max-w-none p-5 sm:p-8 lg:py-16 xl:py-24
						prose-headings:font-extrabold prose-headings:text-slate-800 prose-th:font-extrabold
						prose-h1:text-2xl xl:prose-h1:text-3xl prose-h1:leading-tight
						prose-h2:text-xl prose-h2:leading-snug
						prose-h3:text-base prose-h3:leading-snug
						prose-h4:text-sm prose-h4:leading-snug prose-h4:font-semibold
						prose-strong:text-slate-800 prose-code:text-slate-800 prose-blockquote:text-slate-800
						prose-lead:text-slate-500 prose-a:text-sky-700 prose-hr:border-slate-300"
				>
					<div class="max-w-2xl mx-auto 2xl:translate-x-[-5%]">
						<slot />
					</div>
				</main>
			</div>
		</div>
	</body>
</html>

---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';

import Sidebar from '@site/Sidebar.astro';
import TableOfContents from '@site/TableOfContents.astro';
import { withBase } from '@lib/base';
import type { MarkdownHeading } from 'astro';

interface Props {
	title: string;
	headings?: MarkdownHeading[];
}

const { title, headings } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>VUI - {title}</title>
		{/* Font Awesome Pro via a hosted kit; the Pro files can't live in a public repo. */}
		<script src="https://kit.fontawesome.com/ec399ebc2e.js" crossorigin="anonymous" is:inline></script>
	</head>
	<body class="bg-slate-200">
		{/* The document doesn't scroll; the main column does. Elastic overscroll
		    then bounces the content only, and the nav stays put at every size. */}
		<div class="flex flex-col md:flex-row h-dvh">
			<Sidebar />
			<div data-scroll-root class="@container flex-1 min-w-0 min-h-0 overflow-y-auto overscroll-y-contain scroll-smooth">
				<main
					class="prose prose-slate leading-relaxed max-w-none p-5 sm:p-8 lg:py-16 xl:py-24
						prose-headings:font-extrabold prose-headings:text-slate-800 prose-headings:scroll-mt-8 lg:prose-headings:scroll-mt-16 prose-th:font-extrabold
						prose-h1:text-2xl xl:prose-h1:text-3xl prose-h1:leading-tight
						prose-h2:text-xl prose-h2:leading-snug
						prose-h3:text-base prose-h3:leading-snug
						prose-h4:text-sm prose-h4:leading-snug prose-h4:font-semibold
						prose-strong:text-slate-800 prose-code:text-slate-800 prose-blockquote:text-slate-800
						prose-lead:text-slate-500 prose-a:text-sky-700 prose-hr:border-slate-300"
				>
					{/* The content and the table of contents travel as one centered group.
					    The list's box is the sidebar's width, gutter included, so the
					    content lands on the window's center line. */}
					<div class="max-w-2xl mx-auto lg:max-w-none lg:flex lg:justify-center">
						<div class="min-w-0 lg:w-full lg:max-w-2xl">
							<slot />
						</div>
						<TableOfContents headings={headings} />
					</div>
				</main>
			</div>
		</div>
	</body>
</html>

---
// Preloaded below. Font Awesome ships `font-display: block`, so icons stay
// invisible until the file lands; the preload starts that fetch with the HTML
// rather than after the stylesheet parses.
import solidFont from '../styles/fontawesome/webfonts/fa-solid-900.woff2?url';
import '@fontsource-variable/inter/wght.css';
// Font Awesome, self-hosted: the hosted kit was a blocking third-party script
// that cached for 60 seconds, so every navigation waited on a round trip before
// it painted. Only the two families the pages use, classic solid and regular.
import '../styles/fontawesome/css/fontawesome.min.css';
import '../styles/fontawesome/css/solid.min.css';
import '../styles/fontawesome/css/regular.min.css';
import '../styles/global.css';

import Sidebar from '@site/Sidebar.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>VUI - {title}</title>
		<link rel="preload" href={solidFont} as="font" type="font/woff2" crossorigin />
	</head>
	<body class="bg-slate-200">
		<div class="md:flex">
			<Sidebar />
			<main class="prose prose-slate p-5 sm:p-8 lg:py-16 xl:py-24 xl:px-24 max-w-4xl mx-auto">
				<slot />
			</main>
		</div>
	</body>
</html>

---
// Bare shell for the test pages. No styling of its own beyond Tailwind and the
// font, so a page renders as raw semantic HTML. Don't add layout or color here.
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';

interface Props {
	title: string;
	source?: string;
}

const { title, source } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{source && <meta name="x-source" content={source} />}
		<title>VUI - {title} · Test Page</title>
		{/* Font Awesome Pro via a hosted kit, same as the documentation layout. */}
		<script src="https://kit.fontawesome.com/ec399ebc2e.js" crossorigin="anonymous" is:inline></script>
	</head>
	<body>
		<slot />
	</body>
</html>
